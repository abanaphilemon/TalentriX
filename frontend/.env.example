# Backend API URL
VITE_API_URL=http://localhost:5000/api

# Google OAuth — required for the "Get Started" Google sign-in button.
# 1. Create a project + OAuth Web Client ID at https://console.cloud.google.com/apis/credentials
# 2. Add http://localhost:5173 to "Authorized JavaScript origins"
# 3. Paste the Client ID below and restart `npm run dev`
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com