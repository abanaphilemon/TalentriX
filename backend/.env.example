MONGO_URI=mongodb://localhost:27017/talentbridge
PORT=5000
JWT_SECRET=generate_a_strong_random_secret_here
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed CORS origins (include your frontend URL)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Interview booking emails (reminders/confirmations). When SMTP isn't
# configured, emails are logged to the console instead so dev keeps working.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=TalentriX <noreply@example.com>